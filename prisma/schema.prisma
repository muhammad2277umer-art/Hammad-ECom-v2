generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  UNTOUCHED
  EMAILED
  FOLLOW_UP
  APPROVED
  REJECTED
}

enum VendorType {
  BRAND
  WHOLESALER
  RETAILER
}

enum Marketplace {
  AMAZON
  WALMART
  SHOPIFY
  TIKTOK
  EBAY
  ETSY
  OTHER
}

enum MailProvider {
  DEMO
  IMAP
}

enum MailFolder {
  INBOX
  SENT
  DRAFT
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  MESSAGE
  NOTE
  STATUS
}

enum EmailKind {
  OUTREACH
  FOLLOW_UP
  REPLY
  OTHER
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  vendors   Vendor[]
}

model Client {
  id           String      @id @default(cuid())
  name         String
  storeName    String?
  businessName String?
  email        String?
  phone        String?
  domains      String[]
  website      String?
  instagram    String?
  facebook     String?
  tiktok       String?
  linkedin     String?
  address      String?
  marketplace  Marketplace @default(AMAZON)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  vendors      Vendor[]
  mailboxes    Mailbox[]
}

model Vendor {
  id             String       @id @default(cuid())
  name           String
  type           VendorType   @default(BRAND)
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status         LeadStatus   @default(UNTOUCHED)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  mailboxId      String?
  mailbox        Mailbox?     @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  contactName    String?
  emails         String[]
  phones         String[]
  websites       String[]
  socials        String[]
  address        String?
  description    String?
  firstEmailedAt DateTime?
  lastEmailedAt  DateTime?
  repliedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  emailMessages  EmailMessage[]
  products       Product[]
  activities     Activity[]
  purchaseItems  PurchaseItem[]

  @@index([clientId])
  @@index([status])
  @@index([type])
}

// Amazon research for one product a vendor sells.
model Product {
  id                   String   @id @default(cuid())
  vendorId             String
  vendor               Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  asin                 String
  subNiche             String?
  bsr                  Int?
  bsrDays              Int?
  price                Decimal? @db.Decimal(12, 2)
  priceDays            Int?
  monthlySales         Int?
  amazonStockRate      Float?
  amazonStockRateDays  Int?
  dominantSellerPct    Float?
  dominantSellerDays   Int?
  aPlus                Boolean?
  reviews              Int?
  rating               Float?
  marketplaceProfile   String?
  forecastPurchase     Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([vendorId])
}

// Calls, meetings, notes and status changes. Emails come from EmailMessage.
model Activity {
  id        String       @id @default(cuid())
  vendorId  String
  vendor    Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type      ActivityType
  summary   String
  details   String?
  by        String?
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())

  @@index([vendorId, date])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  asin        String
  productName String?
  moq         Int?
  costPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  unit        String   @default("Units")
  createdAt   DateTime @default(now())

  @@index([vendorId])
}

model Mailbox {
  id           String         @id @default(cuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  address      String         @unique
  displayName  String?
  provider     MailProvider   @default(DEMO)
  imapHost     String?
  imapPort     Int?
  smtpHost     String?
  smtpPort     Int?
  username     String?
  passwordEnc  String?
  sentFolder   String?
  draftsFolder String?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime       @default(now())
  messages     EmailMessage[]
  vendors      Vendor[]
}

model EmailMessage {
  id          String     @id @default(cuid())
  mailboxId   String
  mailbox     Mailbox    @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  vendorId    String?
  vendor      Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  folder      MailFolder
  kind        EmailKind  @default(OTHER)
  messageId   String
  inReplyTo   String?
  imapUid     Int?
  fromAddress String
  toAddress   String
  subject     String
  body        String
  date        DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([mailboxId, folder, messageId])
  @@index([vendorId, folder])
}
